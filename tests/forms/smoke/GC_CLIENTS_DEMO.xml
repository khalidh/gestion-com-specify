         <Item Name="SEARCH_BUTTON" Width="110" CursorStyle="hand" ItemType="Push Button" XPosition="438" FontName="Arial" YPosition="485" DirtyInfo="false" FontWeight="Bold" Label="Rechercher" CanvasName="CLIENT_CANVAS" Height="28">
            <Trigger Name="WHEN-BUTTON-PRESSED" DirtyInfo="false" TriggerText="DECLARE L_PARTY_ID NUMBER; BEGIN IF TRIM(:CLIENT_DEMO.QUERY) IS NULL THEN :CLIENT_DEMO.STATUS := 'Saisir un code ou un nom de client.'; RAISE FORM_TRIGGER_FAILURE; END IF; :GLOBAL.CUSTOMER_ID := NULL; :GLOBAL.DELETE_PENDING := 'N'; GC_APP.PKG_GC_CUSTOMER.SEARCH_CUSTOMER(:CLIENT_DEMO.QUERY, L_PARTY_ID, :CLIENT_DEMO.CLIENT_CODE, :CLIENT_DEMO.CLIENT_NAME, :CLIENT_DEMO.VAT_ID, :CLIENT_DEMO.STREET, :CLIENT_DEMO.POSTAL_CODE, :CLIENT_DEMO.CITY, :CLIENT_DEMO.CREDIT_LIMIT, :CLIENT_DEMO.EMAIL, :CLIENT_DEMO.PHONE); :GLOBAL.CUSTOMER_ID := TO_CHAR(L_PARTY_ID); :CLIENT_DEMO.STATUS := 'Client charge: ' || :CLIENT_DEMO.CLIENT_CODE; EXCEPTION WHEN OTHERS THEN :GLOBAL.CUSTOMER_ID := NULL; :GLOBAL.DELETE_PENDING := 'N'; :CLIENT_DEMO.STATUS := 'Recherche impossible: ' || SQLERRM; MESSAGE(:CLIENT_DEMO.STATUS); RAISE FORM_TRIGGER_FAILURE; END;"/>
         </Item>
         <Item Name="NEW_BUTTON" Width="105" CursorStyle="hand" ItemType="Push Button" XPosition="492" FontName="Arial" YPosition="82" DirtyInfo="false" Label="Nouveau" CanvasName="CLIENT_CANVAS" Height="28">
            <Trigger Name="WHEN-BUTTON-PRESSED" DirtyInfo="false" TriggerText=":GLOBAL.CUSTOMER_ID := NULL; :GLOBAL.DELETE_PENDING := 'N'; :CLIENT_DEMO.CLIENT_CODE := NULL; :CLIENT_DEMO.CLIENT_NAME := NULL; :CLIENT_DEMO.VAT_ID := NULL; :CLIENT_DEMO.EMAIL := NULL; :CLIENT_DEMO.PHONE := NULL; :CLIENT_DEMO.STREET := NULL; :CLIENT_DEMO.POSTAL_CODE := NULL; :CLIENT_DEMO.CITY := NULL; :CLIENT_DEMO.CREDIT_LIMIT := '0'; :CLIENT_DEMO.STATUS := 'Nouvelle fiche client.';"/>
         </Item>
         <Item Name="SAVE_BUTTON" Width="105" CursorStyle="hand" ItemType="Push Button" XPosition="605" FontName="Arial" YPosition="82" DirtyInfo="false" FontWeight="Bold" Label="Enregistrer" CanvasName="CLIENT_CANVAS" Height="28">
            <Trigger Name="WHEN-BUTTON-PRESSED" DirtyInfo="false" TriggerText="DECLARE L_PARTY_ID NUMBER; L_CREDIT NUMBER; BEGIN IF TRIM(:CLIENT_DEMO.CLIENT_CODE) IS NULL OR TRIM(:CLIENT_DEMO.CLIENT_NAME) IS NULL OR TRIM(:CLIENT_DEMO.STREET) IS NULL OR TRIM(:CLIENT_DEMO.POSTAL_CODE) IS NULL OR TRIM(:CLIENT_DEMO.CITY) IS NULL THEN :CLIENT_DEMO.STATUS := 'Code, raison sociale et adresse complete sont obligatoires.'; MESSAGE(:CLIENT_DEMO.STATUS); RAISE FORM_TRIGGER_FAILURE; END IF; L_CREDIT := TO_NUMBER(REPLACE(NVL(TRIM(:CLIENT_DEMO.CREDIT_LIMIT), '0'), ',', '.'), '999999999999999D99', 'NLS_NUMERIC_CHARACTERS=''.,'''); IF :GLOBAL.CUSTOMER_ID IS NULL THEN GC_APP.PKG_GC_CUSTOMER.CREATE_CUSTOMER(P_PARTY_CODE => :CLIENT_DEMO.CLIENT_CODE, P_LEGAL_NAME => :CLIENT_DEMO.CLIENT_NAME, P_ADDRESS_LINE_1 => :CLIENT_DEMO.STREET, P_POSTAL_CODE => :CLIENT_DEMO.POSTAL_CODE, P_CITY => :CLIENT_DEMO.CITY, P_PARTY_ID => L_PARTY_ID, P_VAT_ID => :CLIENT_DEMO.VAT_ID, P_CREDIT_LIMIT_EUR => L_CREDIT, P_EMAIL => :CLIENT_DEMO.EMAIL, P_PHONE => :CLIENT_DEMO.PHONE); :GLOBAL.CUSTOMER_ID := TO_CHAR(L_PARTY_ID); :CLIENT_DEMO.STATUS := 'Client cree: ' || :CLIENT_DEMO.CLIENT_CODE; ELSE GC_APP.PKG_GC_CUSTOMER.UPDATE_CUSTOMER(P_PARTY_ID => TO_NUMBER(:GLOBAL.CUSTOMER_ID), P_PARTY_CODE => :CLIENT_DEMO.CLIENT_CODE, P_LEGAL_NAME => :CLIENT_DEMO.CLIENT_NAME, P_VAT_ID => :CLIENT_DEMO.VAT_ID, P_ADDRESS_LINE_1 => :CLIENT_DEMO.STREET, P_POSTAL_CODE => :CLIENT_DEMO.POSTAL_CODE, P_CITY => :CLIENT_DEMO.CITY, P_CREDIT_LIMIT_EUR => L_CREDIT, P_EMAIL => :CLIENT_DEMO.EMAIL, P_PHONE => :CLIENT_DEMO.PHONE); :CLIENT_DEMO.STATUS := 'Client modifie: ' || :CLIENT_DEMO.CLIENT_CODE; END IF; COMMIT_FORM; :GLOBAL.DELETE_PENDING := 'N'; MESSAGE(:CLIENT_DEMO.STATUS); EXCEPTION WHEN FORM_TRIGGER_FAILURE THEN RAISE; WHEN OTHERS THEN :CLIENT_DEMO.STATUS := 'Enregistrement impossible: ' || SQLERRM; MESSAGE(:CLIENT_DEMO.STATUS); RAISE FORM_TRIGGER_FAILURE; END;"/>
         </Item>
         <Item Name="DELETE_BUTTON" Width="105" CursorStyle="hand" ItemType="Push Button" XPosition="379" FontName="Arial" YPosition="82" DirtyInfo="false" Label="Supprimer" CanvasName="CLIENT_CANVAS" Height="28">
            <Trigger Name="WHEN-BUTTON-PRESSED" DirtyInfo="false" TriggerText="DECLARE L_PARTY_ID NUMBER; BEGIN IF :GLOBAL.CUSTOMER_ID IS NULL THEN :CLIENT_DEMO.STATUS := 'Rechercher ou enregistrer un client avant suppression.'; MESSAGE(:CLIENT_DEMO.STATUS); RAISE FORM_TRIGGER_FAILURE; END IF; IF NVL(:GLOBAL.DELETE_PENDING, 'N') &lt;&gt; 'Y' THEN :GLOBAL.DELETE_PENDING := 'Y'; :CLIENT_DEMO.STATUS := 'Cliquer encore sur Supprimer pour confirmer.'; MESSAGE(:CLIENT_DEMO.STATUS); RAISE FORM_TRIGGER_FAILURE; END IF; L_PARTY_ID := TO_NUMBER(:GLOBAL.CUSTOMER_ID); GC_APP.PKG_GC_CUSTOMER.DELETE_CUSTOMER(L_PARTY_ID); COMMIT_FORM; :GLOBAL.CUSTOMER_ID := NULL; :GLOBAL.DELETE_PENDING := 'N'; :CLIENT_DEMO.CLIENT_CODE := NULL; :CLIENT_DEMO.CLIENT_NAME := NULL; :CLIENT_DEMO.VAT_ID := NULL; :CLIENT_DEMO.EMAIL := NULL; :CLIENT_DEMO.PHONE := NULL; :CLIENT_DEMO.STREET := NULL; :CLIENT_DEMO.POSTAL_CODE := NULL; :CLIENT_DEMO.CITY := NULL; :CLIENT_DEMO.CREDIT_LIMIT := NULL; :CLIENT_DEMO.STATUS := 'Client supprime.'; MESSAGE(:CLIENT_DEMO.STATUS); EXCEPTION WHEN FORM_TRIGGER_FAILURE THEN RAISE; WHEN OTHERS THEN :GLOBAL.DELETE_PENDING := 'N'; :CLIENT_DEMO.STATUS := 'Suppression impossible: ' || SQLERRM; MESSAGE(:CLIENT_DEMO.STATUS); RAISE FORM_TRIGGER_FAILURE; END;"/>
         </Item>
         <Item Name="CLOSE_BUTTON" Width="105" CursorStyle="hand" ItemType="Push Button" XPosition="718" FontName="Arial" YPosition="82" DirtyInfo="false" Label="Fermer" CanvasName="CLIENT_CANVAS" Height="28">
